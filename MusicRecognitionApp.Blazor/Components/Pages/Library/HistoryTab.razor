@using MusicRecognitionApp.Core.Models.Business

<MudToolBar>
    <MudTextField T="string" 
                  ValueChanged="@OnSearch" 
                  Placeholder="Search by title or artist" 
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" 
                  IconSize="Size.Medium" 
                  Class="mt-1 mr-3" 
                  Style="max-width:250px;"/>
    <MudSpacer />
</MudToolBar>


@if (_items == null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mt-8" />
}
else
{
    <MudTable Items="@_items" Hover="true" Striped="true" FixedHeader="true">
        <ColGroup>
            @foreach(var col in Provider.Columns)
            {
                <col style="@col.WidthValuePercent%;" />
            }
        </ColGroup>
        <HeaderContent>
            @foreach(var col in Provider.Columns)
            {
                <MudTh>@col.Name</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            @foreach (var col in Provider.Columns)
            {
                <MudTd>@col.ValueSelector(context)</MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No recognition history yet.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}