@page "/login"

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Login</MudText>
    
        <MudForm @bind-Errors="@_errors" Model="@_model">
            <MudTextField @bind-Value="_model.Username"
                          Label="Username"
                          Variant="Variant.Outlined" 
                          Validation = "@ValidationUsername" />

            <MudTextField @bind-Value="_model.Password" 
                          Label="Password" 
                          Variant="Variant.Outlined" 
                          InputType="InputType.Password" 
                          Class="mt-4" 
                          Validation = "@ValidationPassword" />
            
            <MudButton OnClick="HandleLogin"
                       Color="Color.Primary" 
                       Variant="Variant.Filled" 
                       FullWidth="true" 
                       Class="mt-6">
                       Sing In 
            </MudButton>

            <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-4">
                <MudLink Href="/register">Don't have an account? Click here to Register</MudLink>
            </MudText>
        </MudForm>
    </MudPaper>
</MudContainer>